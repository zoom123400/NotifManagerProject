<?xml version="1.0" encoding="utf-8"?>
<!--
    item_app.xml
    A single row in the app list RecyclerView.

    Structure:
      RelativeLayout (root — entire row is tappable)
        └─ ImageView   (app icon, 48×48 dp)
        └─ LinearLayout (vertical, holds name + package + system badge)
              └─ TextView  (app name)
              └─ TextView  (package name — smaller, secondary color)
              └─ TextView  (SYSTEM badge — only visible for system apps)
        └─ CheckBox    (notifications toggle, right-anchored)
-->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/selector_item_bg"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:minHeight="72dp">

    <!-- App Icon -->
    <ImageView
        android:id="@+id/ivAppIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:scaleType="fitCenter"
        android:contentDescription="@string/app_icon_description" />

    <!-- Notification toggle checkbox (right side) -->
    <CheckBox
        android:id="@+id/cbNotifications"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:focusable="false"
        android:contentDescription="@string/toggle_notifications_description" />

    <!-- Text column: name + package + system badge -->
    <LinearLayout
        android:id="@+id/llTextBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@id/ivAppIcon"
        android:layout_toLeftOf="@id/cbNotifications"
        android:layout_centerVertical="true"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingRight="8dp">

        <!-- App Name -->
        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Package Name (subtitle) -->
        <TextView
            android:id="@+id/tvPackageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/colorTextSecondary"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="1dp" />

        <!-- System App Badge -->
        <TextView
            android:id="@+id/tvSystemBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/system_badge"
            android:textSize="10sp"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_system_badge"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:layout_marginTop="3dp"
            android:visibility="gone" />

    </LinearLayout>

</RelativeLayout>
